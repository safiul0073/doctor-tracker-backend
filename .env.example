# Server
PORT=5001
NODE_ENV=development

# Database
# Leave MONGODB_URI empty to automatically start an embedded local MongoDB instance
# with persisted data in ./backend/.mongodb-data and auto-seeded demo records.
MONGODB_URI=
USE_MEMORY_DB=true

# Authentication
JWT_SECRET=change-this-to-a-long-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# CORS (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3002

# Default Seeded Admin Credentials
ADMIN_NAME=Dr. Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
